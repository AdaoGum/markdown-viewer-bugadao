{
  "name": "@bugadao/markdown-viewer",
  "version": "0.1.0",
  "description": "Markdown Viewer Bugadão: Vue 3 Markdown viewer/editor with one-click export to PDF, DOCX, ODT, EPUB, HTML, RTF, LaTeX, PNG, JPEG, SVG, TXT, CSV and JSON.",
  "type": "module",
  "license": "MIT",
  "author": "AdaoGum",
  "keywords": [
    "vue",
    "vue3",
    "markdown",
    "viewer",
    "editor",
    "export",
    "pdf",
    "docx",
    "odt",
    "epub"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/markdown-viewer.js",
  "module": "./dist/markdown-viewer.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/markdown-viewer.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "vite build --config vite.lib.config.ts && vue-tsc -p tsconfig.lib.json",
    "build:demo": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "deploy:site": "npm test && npm run build:demo && wrangler pages deploy dist-demo --project-name=markdown-viewer-bugadao --branch=main --commit-dirty=true"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "docx": "^9.8.1",
    "html-to-image": "^1.11.13",
    "html2pdf.js": "^0.14.0",
    "jszip": "^3.10.2",
    "mdast-util-to-string": "^4.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "jsdom": "^30.1.1",
    "typescript": "~5.9",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.145.0"
  }
}
